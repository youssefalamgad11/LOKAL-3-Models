{
  "version": 2,
  "builds": [
    { "src": "**/*.html", "use": "@vercel/static" },
    { "src": "**/*.css", "use": "@vercel/static" },
    { "src": "**/*.js", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/segmentation", "dest": "/segmentation.html" },
    { "src": "/recommendations", "dest": "/recommendations.html" },
    { "src": "/tryon", "dest": "/tryon.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
